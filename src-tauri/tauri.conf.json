{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "monolith",
  "version": "0.2.1",
  "identifier": "com.monolith",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Monolith",
        "fullscreen": true,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "shadow": false,
        "alwaysOnTop": false,
        "visible": true,
        "minWidth": 800,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../media/custom-visualizers/**/*": "media/custom-visualizers/",
      "../media/layouts/*": "media/layouts/",
      "../media/skins/*": "media/skins/"
    }
  }
}
